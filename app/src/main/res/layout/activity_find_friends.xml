<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_grey"
    tools:context=".FindFriendsActivity">
    <include
        layout="@layout/app_bar_layout"
        android:id="@+id/find_friends_toolbar" />
    <EditText
        android:id="@+id/search_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/find_friends_toolbar"
        android:layout_margin="20dp"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_sharp_person_search_24"
        android:drawablePadding="8dp"
        android:hint="@string/ui_activity_find_friends_hint_1"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:padding="16dp"
        android:minHeight="58dp"
        android:textColor="@color/black" />
    <TextView
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/search_input"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/ui_activity_find_friends_text_2"
        android:textColor="#777777"
        android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/find_friends_list"
        android:layout_below="@+id/search_input"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:padding="12dp"
        android:clipToPadding="false" />
</RelativeLayout>