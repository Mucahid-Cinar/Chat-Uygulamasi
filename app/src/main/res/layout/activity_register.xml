<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_auth">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ic_brand"
            android:contentDescription="@string/ui_activity_register_contentdescription_1" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Me.Title"
            android:text="@string/ui_activity_register_text_2" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Me.Body"
            android:text="@string/ui_activity_register_text_3" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Me.Label"
            android:text="@string/ui_activity_register_text_4" />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Me.Input"
            android:id="@+id/register_email"
            android:hint="@string/ui_activity_register_hint_5"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:imeOptions="actionNext" />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Me.Input"
            android:id="@+id/register_password"
            android:hint="@string/ui_activity_register_hint_6"
            android:inputType="textPassword"
            android:autofillHints="newPassword"
            android:imeOptions="actionDone" />
        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Me.Button"
            android:id="@+id/register_button"
            android:text="@string/ui_activity_register_text_7" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Me.Link"
            android:text="@string/ui_activity_register_text_8"
            android:id="@+id/have_account"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>
</ScrollView>