<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_auth">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ic_brand"
            android:contentDescription="@string/ui_activity_phone_login_contentdescription_1" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Me.Title"
            android:text="@string/ui_activity_phone_login_text_2" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Me.Body"
            android:text="@string/ui_activity_phone_login_text_3" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Me.Label"
            android:text="@string/ui_activity_phone_login_text_4" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/country_code"
            android:text="@string/ui_activity_phone_login_text_5"
            android:visibility="gone" />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Me.Input"
            android:id="@+id/phone_number_input"
            android:hint="@string/ui_activity_phone_login_hint_6"
            android:inputType="phone"
            android:maxLength="10"
            android:autofillHints="phoneNumberNational" />
        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Me.Button"
            android:id="@+id/send_code_button"
            android:text="@string/ui_activity_phone_login_text_7" />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Me.Input"
            android:id="@+id/verification_code_input"
            android:hint="@string/ui_activity_phone_login_hint_8"
            android:inputType="number"
            android:maxLength="6"
            android:visibility="gone" />
        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Me.Button"
            android:id="@+id/verify_code_button"
            android:text="@string/ui_activity_phone_login_text_9"
            android:visibility="gone" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Me.Link"
            android:text="@string/ui_activity_phone_login_text_10"
            android:id="@+id/change_phone_button"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>
</ScrollView>