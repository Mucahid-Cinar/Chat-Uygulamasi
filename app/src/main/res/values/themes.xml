<resources xmlns:tools="http://schemas.android.com/tools">
<style name="Theme.ME_Chat" parent="Theme.MaterialComponents.Light.NoActionBar">
<item name="colorPrimary">@color/blue</item><item name="colorPrimaryVariant">@color/purple_700</item><item name="colorPrimaryDark">@color/purple_700</item>
<item name="colorOnPrimary">@color/white</item><item name="colorSecondary">@color/blue</item><item name="colorAccent">@color/blue</item>
<item name="android:textColorPrimary">@color/black</item><item name="android:textColorSecondary">@color/muted</item>
<item name="android:windowBackground">@color/background_grey</item><item name="android:statusBarColor">@color/purple_700</item>
<item name="android:navigationBarColor">@color/background_grey</item><item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
<item name="android:windowAnimationStyle">@style/Me.WindowAnimation</item>
<item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
</style>
<style name="Theme.ME_Chat.Crop" parent="Theme.MaterialComponents.Light.DarkActionBar"><item name="colorPrimary">@color/blue</item><item name="colorPrimaryDark">@color/purple_700</item><item name="colorAccent">@color/blue</item><item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item></style>
<style name="Me"/>
<style name="Me.Body"><item name="android:textSize">15sp</item><item name="android:textColor">@color/muted</item><item name="android:lineSpacingExtra">4dp</item></style>
<style name="Me.Title"><item name="android:textSize">34sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:textColor">@color/black</item><item name="android:layout_marginBottom">12dp</item></style>
<style name="Me.Label" parent="Me.Body"><item name="android:textSize">12sp</item><item name="android:letterSpacing">0.12</item><item name="android:layout_marginTop">24dp</item><item name="android:layout_marginBottom">8dp</item></style>
<style name="Me.Input"><item name="android:background">@drawable/bg_input</item><item name="android:minHeight">58dp</item><item name="android:padding">16dp</item><item name="android:textSize">16sp</item><item name="android:textColor">@color/black</item><item name="android:textColorHint">@color/muted</item><item name="android:layout_marginTop">12dp</item><item name="android:singleLine">true</item></style>
<style name="Me.Button"><item name="android:background">@drawable/bg_button</item><item name="backgroundTint">@null</item><item name="android:minHeight">56dp</item><item name="android:padding">12dp</item><item name="android:layout_marginTop">20dp</item><item name="android:textColor">@color/white</item><item name="android:textAllCaps">false</item><item name="android:textSize">16sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:stateListAnimator">@null</item></style>
<style name="Me.Secondary" parent="Me.Button"><item name="android:background">@drawable/bg_secondary</item><item name="android:textColor">@color/blue</item><item name="android:layout_marginTop">12dp</item></style>
<style name="Me.Link" parent="Me.Body"><item name="android:textColor">@color/blue</item><item name="android:gravity">center</item><item name="android:minHeight">48dp</item><item name="android:padding">12dp</item><item name="android:fontFamily">sans-serif-medium</item></style>
<style name="Me.WindowAnimation"><item name="android:activityOpenEnterAnimation">@anim/page_enter</item><item name="android:activityOpenExitAnimation">@anim/page_exit</item><item name="android:activityCloseEnterAnimation">@anim/page_return</item><item name="android:activityCloseExitAnimation">@anim/page_close</item></style>
</resources>
